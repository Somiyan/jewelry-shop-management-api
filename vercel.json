{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "{src/assets/fonts/**,node_modules/pdfkit/js/data/**}"
    }
  },
  "crons": [
    {
      "path": "/api/rates/sync/cron",
      "schedule": "30 8 * * *"
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ]
}
