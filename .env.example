PORT=5050
NODE_ENV=development
# Required. On Vercel, set this in Project Settings -> Environment Variables.
MONGO_URI=mongodb://localhost:27017/jewelry_shop
# Required.
JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_IN=8h
# The deployed frontend origin, e.g. https://your-app.vercel.app
CORS_ORIGIN=http://localhost:5173

# Printed on the invoice PDF only — all optional, sensible defaults in src/config/shopProfile.js
SHOP_NAME=Sonali Jewellers
SHOP_TAGLINE=Dealers in Fine Gold Ornaments
SHOP_ADDRESS=Shop No. A-002, Rupali Darshan CHS., Near Hanuman Mandir, Bhayandar (E), Thane - 401105.
SHOP_PHONE=
SHOP_GSTIN=
SHOP_HALLMARK_LABEL=BIS 916 Hallmark Jewellery
SHOP_BANK_ACCOUNT_NAME=
SHOP_BANK_NAME=
SHOP_BANK_ACCOUNT_NUMBER=
SHOP_BANK_IFSC=

# --- Live gold/silver rates (RapidAPI) -------------------------------------
# The key is server-side only and must never reach the browser.
RAPIDAPI_KEY=
RAPIDAPI_HOST=gold-silver-rates-india.p.rapidapi.com
RAPIDAPI_GOLD_SILVER_URL=https://gold-silver-rates-india.p.rapidapi.com/api/Fetch-Gold-Silver/
RATE_PROVIDER_CITY=mumbai
RATE_PROVIDER_TIMEOUT_MS=10000
RATE_PROVIDER_MAX_ATTEMPTS=3
RATE_PROVIDER_RETRY_DELAY_MS=1000

# Daily sync at 2:00 PM IST. Timezone is explicit — the host clock is UTC.
RATE_SYNC_CRON=0 14 * * *
RATE_SYNC_TIMEZONE=Asia/Kolkata
RATE_SYNC_ENABLED=true
# Shared secret for POST /api/rates/sync/cron (used by Vercel Cron).
CRON_SECRET=

# A stored rate older than this is shown as STALE in the UI.
RATE_STALE_AFTER_HOURS=36

# Safety bounds, in INR per gram of PURE metal. A normalized rate outside
# these is rejected rather than stored — it means the provider changed units.
RATE_GOLD_MIN_PER_GRAM=2000
RATE_GOLD_MAX_PER_GRAM=40000
RATE_SILVER_MIN_PER_GRAM=20
RATE_SILVER_MAX_PER_GRAM=1000
